@using MohamedSprint1V2.DLL.ModelVM.Product
@model UpdateProductVM

@{
    ViewData["Title"] = "Edit Product: " + Model.Name;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h3 class="admin-card-title">
                    <i class="fa-solid fa-pen-to-square text-primary"></i>
                    Edit Product
                </h3>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                </a>
            </div>

            <form asp-area="Admin" asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Img" />
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-3"></div>

                <div class="row g-3">
                    <!-- Product Name -->
                    <div class="col-12 col-md-8">
                        <label asp-for="Name" class="admin-form-label">Product Name *</label>
                        <input asp-for="Name" class="form-control admin-form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Price -->
                    <div class="col-12 col-md-4">
                        <label asp-for="Price" class="admin-form-label">Price ($) *</label>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control admin-form-control" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <!-- Category -->
                    <div class="col-12 col-md-6">
                        <label asp-for="CategoryId" class="admin-form-label">Category *</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select admin-form-control" required>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Image Upload -->
                    <div class="col-12 col-md-6">
                        <label class="admin-form-label">Replace Image (Optional)</label>
                        <input type="file" name="imageFile" id="editImageInput" accept="image/*" class="form-control admin-form-control" />
                        <small class="text-muted">Leave empty to keep existing image</small>
                    </div>

                    <!-- Current / New Image Preview -->
                    <div class="col-12">
                        <label class="admin-form-label">Current / Preview Image</label>
                        <div>
                            <img id="currentImagePreview" src="@(string.IsNullOrEmpty(Model.Img) ? "https://placehold.co/180" : Model.Img)" 
                                 alt="@Model.Name" 
                                 style="max-width: 180px; max-height: 180px; object-fit: cover; border-radius: 12px; border: 2px solid var(--admin-border); padding: 4px;" />
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="admin-form-label">Product Description</label>
                        <textarea asp-for="Description" rows="4" class="form-control admin-form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="col-12 d-flex justify-content-end gap-3 mt-4">
                        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn-admin-primary px-4">
                            <i class="fa-solid fa-check"></i> Update Product
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('editImageInput')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    const img = document.getElementById('currentImagePreview');
                    img.src = evt.target.result;
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}
