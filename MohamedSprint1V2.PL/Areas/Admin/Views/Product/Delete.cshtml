@using MohamedSprint1V2.DLL.ModelVM.Product
@model UpdateProductVM

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="admin-card border-danger">
            <div class="admin-card-header border-danger">
                <h3 class="admin-card-title text-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Confirm Delete Product
                </h3>
            </div>

            <div class="text-center my-3">
                <img src="@(string.IsNullOrEmpty(Model.Img) ? "https://placehold.co/150" : Model.Img)" 
                     alt="@Model.Name" 
                     style="width: 120px; height: 120px; object-fit: cover; border-radius: 12px; border: 2px solid var(--admin-border);" />
                <h4 class="text-white mt-3 mb-1">@Model.Name</h4>
                <div class="badge bg-success-subtle text-success fs-6 fw-bold mb-3">
                    $@Model.Price.ToString("N2")
                </div>
                <p class="text-muted small">@Model.Description</p>
            </div>

            <div class="alert alert-danger rounded-3 text-center my-4">
                <strong>Warning!</strong> Are you sure you want to permanently delete this product? This action cannot be undone.
            </div>

            <form asp-area="Admin" asp-controller="Product" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Img" />
                <input type="hidden" asp-for="Name" />
                <input type="hidden" asp-for="CategoryId" />

                <div class="d-flex justify-content-center gap-3">
                    <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                        <i class="fa-solid fa-trash-can me-1"></i> Yes, Delete Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
