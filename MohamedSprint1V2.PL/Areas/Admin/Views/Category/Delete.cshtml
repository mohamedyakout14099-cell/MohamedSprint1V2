@using MohamedSprint1V2.DLL.ModelVM.Category
@model UpdaeteCategoryVM

@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="admin-card border-danger">
            <div class="admin-card-header border-danger">
                <h3 class="admin-card-title text-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Confirm Delete Category
                </h3>
            </div>

            <div class="text-center my-3">
                <div class="badge bg-danger-subtle text-danger fs-5 fw-bold mb-2">
                    #@Model.Id
                </div>
                <h4 class="text-white mt-2">@Model.Name</h4>
                <p class="text-muted small">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</p>
            </div>

            <div class="alert alert-danger rounded-3 text-center my-4">
                <strong>Warning!</strong> Deleting this category might affect associated products. Are you sure you want to proceed?
            </div>

            <form asp-area="Admin" asp-controller="Category" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Name" />

                <div class="d-flex justify-content-center gap-3">
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                        <i class="fa-solid fa-trash-can me-1"></i> Yes, Delete Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
