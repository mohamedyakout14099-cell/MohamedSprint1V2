@model List<OrderListVM>

@{
    ViewData["Title"] = "Orders Management";
    string activeStatus = ViewBag.ActiveStatus ?? "All";
    string? searchTerm = ViewBag.SearchTerm;
}

<div class="admin-card">
    <div class="admin-card-header flex-wrap gap-3">
        <div>
            <h3 class="admin-card-title">
                <i class="fa-solid fa-cart-flatbed-suitcase text-primary"></i>
                Customer Orders Management
            </h3>
            <span class="text-muted small">Total Orders: <strong>@(Model?.Count ?? 0)</strong></span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form asp-area="Admin" asp-controller="Order" asp-action="Index" method="get" class="d-flex gap-2">
                <input type="hidden" name="status" value="@(activeStatus == "All" ? "" : activeStatus)" />
                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text bg-dark border-secondary text-muted">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" name="search" value="@searchTerm" class="form-control admin-form-control" 
                           placeholder="Search Order #, customer..." />
                    <button type="submit" class="btn btn-outline-secondary">Search</button>
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="@activeStatus" class="btn btn-outline-danger">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Status Filters Bar -->
    <div class="p-3 border-bottom border-secondary border-opacity-25 bg-dark bg-opacity-25 d-flex gap-2 flex-wrap">
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-search="@searchTerm" 
           class="btn btn-sm @(activeStatus == "All" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
            All
        </a>
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Pending" asp-route-search="@searchTerm" 
           class="btn btn-sm @(activeStatus == "Pending" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary") rounded-pill px-3">
            Pending
        </a>
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Processing" asp-route-search="@searchTerm" 
           class="btn btn-sm @(activeStatus == "Processing" ? "btn-info text-dark fw-bold" : "btn-outline-secondary") rounded-pill px-3">
            Processing
        </a>
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Shipped" asp-route-search="@searchTerm" 
           class="btn btn-sm @(activeStatus == "Shipped" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
            Shipped
        </a>
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Delivered" asp-route-search="@searchTerm" 
           class="btn btn-sm @(activeStatus == "Delivered" ? "btn-success fw-bold" : "btn-outline-secondary") rounded-pill px-3">
            Delivered
        </a>
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="Cancelled" asp-route-search="@searchTerm" 
           class="btn btn-sm @(activeStatus == "Cancelled" ? "btn-danger fw-bold" : "btn-outline-secondary") rounded-pill px-3">
            Cancelled
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">Order #</th>
                        <th>Customer</th>
                        <th>Destination</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 130px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold text-primary">#@order.OrderId</span>
                            </td>
                            <td>
                                <div class="fw-bold text-white">@order.CustomerName</div>
                                <small class="text-muted">@(string.IsNullOrEmpty(order.CustomerEmail) ? order.PhoneNumber : order.CustomerEmail)</small>
                            </td>
                            <td>
                                <span class="text-secondary small">
                                    <i class="fa-solid fa-city me-1"></i>@order.City
                                </span>
                            </td>
                            <td>
                                <span class="text-white small">@order.OrderDate.ToString("yyyy-MM-dd")</span>
                                <small class="text-muted d-block">@order.OrderDate.ToString("hh:mm tt")</small>
                            </td>
                            <td>
                                <span class="fw-bold text-success">$@order.TotalPrice.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-light px-2 py-1 rounded-pill small">
                                    @order.PaymentMethod
                                </span>
                            </td>
                            <td>
                                @if (order.OrderStatus == "Approved" || order.OrderStatus == "Delivered")
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-semibold">
                                        <i class="fa-solid fa-circle-check me-1"></i>@order.OrderStatus
                                    </span>
                                }
                                else if (order.OrderStatus == "Processing" || order.OrderStatus == "Shipped")
                                {
                                    <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold">
                                        <i class="fa-solid fa-truck-fast me-1"></i>@order.OrderStatus
                                    </span>
                                }
                                else if (order.OrderStatus == "Cancelled")
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill fw-semibold">
                                        <i class="fa-solid fa-circle-xmark me-1"></i>@order.OrderStatus
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill fw-semibold">
                                        <i class="fa-solid fa-clock me-1"></i>@order.OrderStatus
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" 
                                   class="btn btn-sm btn-outline-primary rounded-3" title="Manage Order">
                                    <i class="fa-solid fa-sliders me-1"></i>Manage
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-box-open fa-3x mb-3 opacity-50"></i>
            <h5>No orders found</h5>
            <p class="small">No orders match the selected filters.</p>
        </div>
    }
</div>
