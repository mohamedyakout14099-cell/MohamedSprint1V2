@using MohamedSprint1V2.DLL.ModelVM.Category
@using MohamedSprint1V2.DLL.ModelVM.ResponseResult
@model Response<List<GetallCategoryVM>>

@{
    ViewData["Title"] = "Categories Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categoriesList = Model?.result ?? new List<GetallCategoryVM>();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        padding: 28px;
        animation: fadeIn 0.4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-card-header {
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        padding: 20px 24px;
        border-radius: 14px;
        margin-bottom: 24px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
    }

    .custom-card-header h3 {
        margin: 0;
        font-weight: 700;
        font-size: 1.45rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .badge-count {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
        font-size: 0.85rem;
        padding: 6px 14px;
        border-radius: 20px;
        backdrop-filter: blur(4px);
        font-weight: 600;
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 22px;
    }

    .search-box {
        position: relative;
        max-width: 320px;
        width: 100%;
    }

    .search-box input {
        border-radius: 10px;
        padding-left: 38px;
        border: 1px solid #d1d5db;
        transition: all 0.2s ease;
    }

    .search-box input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
    }

    .search-box .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

    .custom-table thead th {
        background-color: #1e40af;
        color: #ffffff;
        font-weight: 600;
        padding: 14px 16px;
        text-align: left;
        font-size: 0.9rem;
        border: none;
    }

    .custom-table thead th:last-child {
        text-align: center;
    }

    .custom-table tbody tr {
        transition: background-color 0.2s ease;
    }

    .custom-table tbody tr:hover {
        background-color: #f0f7ff;
    }

    .custom-table tbody td {
        padding: 14px 16px;
        vertical-align: middle;
        border-top: 1px solid #e5e7eb;
        color: #374151;
        font-size: 0.92rem;
    }

    .action-btn {
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .category-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
        color: #1d4ed8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        border: 1px solid #bfdbfe;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #6b7280;
    }

    .empty-state i {
        font-size: 3.5rem;
        color: #9ca3af;
        margin-bottom: 16px;
    }
</style>

<div class="custom-card">
    <!-- Header Banner -->
    <div class="custom-card-header">
        <div>
            <h3>
                <i class="fa-solid fa-folder-tree"></i>
                Categories Management
            </h3>
            <small class="text-white-50">Manage product categories and classifications</small>
        </div>
        <div class="badge-count">
            <i class="fa-solid fa-folder-open me-1"></i> Total: @categoriesList.Count Categories
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Action Bar -->
    <div class="action-bar">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" id="categorySearchInput" class="form-control" placeholder="Search categories by name, description..." />
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary shadow-sm" style="border-radius: 10px; font-weight: 600;">
                <i class="fa-solid fa-circle-plus me-1"></i> Create Category
            </a>
        </div>
    </div>

    <!-- Categories Table -->
    @if (categoriesList.Count > 0)
    {
        <div class="table-responsive">
            <table class="table custom-table" id="categoriesTable">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Date Created</th>
                        <th style="width: 170px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in categoriesList)
                    {
                        <tr>
                            <td class="text-muted fw-semibold">@item.id</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="category-icon-box shadow-sm">
                                        <i class="fa-solid fa-folder"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.name</div>
                                        <small class="text-muted">ID: @item.id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 320px;" title="@item.description">
                                    @(string.IsNullOrWhiteSpace(item.description) ? "-" : item.description)
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary small">
                                    <i class="fa-regular fa-calendar me-1"></i>
                                    @(item.CreatedTime != default ? item.CreatedTime.ToString("dd MMM yyyy") : "-")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-warning btn-sm action-btn text-dark" title="Edit Category">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-danger btn-sm action-btn" title="Delete Category">
                                        <i class="fa-solid fa-trash me-1"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-folder-open"></i>
            <h4>No Categories Available</h4>
            <p class="text-muted">You haven't created any categories yet. Click the button below to add your first category.</p>
            <a asp-action="Create" class="btn btn-outline-primary mt-2">
                <i class="fa-solid fa-circle-plus me-1"></i> Create First Category
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('categorySearchInput')?.addEventListener('keyup', function () {
            const query = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#categoriesTable tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
            });
        });
    </script>
}
