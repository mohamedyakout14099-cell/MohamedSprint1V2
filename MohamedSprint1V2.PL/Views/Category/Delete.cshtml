@using MohamedSprint1V2.DLL.ModelVM.Category
@model UpdaeteCategoryVM

@{
    ViewData["Title"] = "Delete Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        animation: fadeIn 0.4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-card-header {
        background: linear-gradient(135deg, #dc2626, #ef4444);
        padding: 20px 24px;
        color: white;
    }

    .custom-card-header h4 {
        margin: 0;
        font-weight: 700;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .category-details-card {
        background: #f8fafc;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 20px;
    }

    .detail-label {
        font-weight: 600;
        color: #64748b;
        font-size: 0.85rem;
        margin-bottom: 2px;
    }

    .detail-value {
        font-weight: 600;
        color: #1e293b;
        font-size: 1rem;
    }
</style>

<div class="row justify-content-center my-4">
    <div class="col-lg-7 col-md-9">
        <div class="custom-card">
            <!-- Header -->
            <div class="custom-card-header">
                <h4>
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Delete Category Confirmation
                </h4>
                <small class="text-white-50">Please review category details before permanently deleting</small>
            </div>

            <!-- Body -->
            <div class="p-4">
                <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-3 me-3"></i>
                    <div>
                        <strong class="d-block">Are you sure you want to delete this category?</strong>
                        <span class="small">This will permanently remove the category. Products under this category may be affected.</span>
                    </div>
                </div>

                <!-- Category Summary -->
                <div class="category-details-card mb-4">
                    <div class="mb-3">
                        <span class="badge bg-secondary mb-1">ID: #@Model.Id</span>
                        <h4 class="fw-bold text-dark mb-0">@Model.Name</h4>
                    </div>

                    <div class="pt-3 border-top">
                        <div class="detail-label">Description</div>
                        <div class="detail-value text-muted small">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided" : Model.Description)
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Name" />
                    <input type="hidden" asp-for="Description" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">
                            <i class="fa-solid fa-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger px-4 py-2 shadow-sm fw-bold" style="border-radius: 10px;">
                            <i class="fa-solid fa-trash-can me-1"></i> Yes, Delete Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>