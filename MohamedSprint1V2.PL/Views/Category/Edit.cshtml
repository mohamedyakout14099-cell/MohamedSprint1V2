@using MohamedSprint1V2.DLL.ModelVM.Category
@model UpdaeteCategoryVM

@{
    ViewData["Title"] = "Edit Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        animation: fadeIn 0.4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-card-header {
        background: linear-gradient(135deg, #d97706, #f59e0b);
        padding: 20px 24px;
        color: white;
    }

    .custom-card-header h4 {
        margin: 0;
        font-weight: 700;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-control, textarea {
        border-radius: 10px;
        padding: 10px 14px;
        border: 1px solid #d1d5db;
        transition: all 0.2s ease;
    }

    .form-control:focus, textarea:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
    }

    .form-label {
        font-weight: 600;
        color: #92400e;
        margin-bottom: 6px;
    }
</style>

<div class="row justify-content-center my-4">
    <div class="col-lg-7 col-md-9">
        <div class="custom-card">
            <!-- Header -->
            <div class="custom-card-header">
                <h4>
                    <i class="fa-solid fa-pen-to-square"></i>
                    Edit Category #@Model.Id
                </h4>
                <small class="text-white-50">Update category details and description</small>
            </div>

            <!-- Form Body -->
            <div class="p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <!-- Name -->
                        <div class="col-12">
                            <label asp-for="Name" class="form-label">
                                <i class="fa-solid fa-tag text-warning me-1"></i> Category Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">
                                <i class="fa-solid fa-align-left text-warning me-1"></i> Description <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" rows="4" class="form-control" placeholder="Enter category description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-12 mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">
                                <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-warning px-4 py-2 shadow-sm text-dark fw-bold" style="border-radius: 10px;">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}