@using MohamedSprint1V2.DLL.ModelVM.Product
@model UpdateProductVM

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .custom-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        animation: fadeIn 0.4s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .custom-card-header {
        background: linear-gradient(135deg, #d97706, #f59e0b);
        padding: 20px 24px;
        color: white;
    }

    .custom-card-header h4 {
        margin: 0;
        font-weight: 700;
        font-size: 1.35rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-control, textarea {
        border-radius: 10px;
        padding: 10px 14px;
        border: 1px solid #d1d5db;
        transition: all 0.2s ease;
    }

    .form-control:focus, textarea:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
    }

    .form-label {
        font-weight: 600;
        color: #92400e;
        margin-bottom: 6px;
    }

    .preview-container {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        background: #f8fafc;
        min-height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }

    .preview-img {
        max-width: 100%;
        max-height: 180px;
        object-fit: contain;
        border-radius: 8px;
    }
</style>

<div class="row justify-content-center my-4">
    <div class="col-lg-8 col-md-10">
        <div class="custom-card">
            <!-- Header -->
            <div class="custom-card-header">
                <h4>
                    <i class="fa-solid fa-pen-to-square"></i>
                    Edit Product #@Model.Id
                </h4>
                <small class="text-white-50">Update product specifications, price, or category</small>
            </div>

            <!-- Form Body -->
            <div class="p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <!-- Name -->
                        <div class="col-md-12">
                            <label asp-for="Name" class="form-label">
                                <i class="fa-solid fa-tag text-warning me-1"></i> Product Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label">
                                <i class="fa-solid fa-align-left text-warning me-1"></i> Description <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" rows="3" class="form-control" placeholder="Enter full product description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Price -->
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label">
                                <i class="fa-solid fa-dollar-sign text-warning me-1"></i> Price (EGP) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <!-- Category ID -->
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label">
                                <i class="fa-solid fa-folder text-warning me-1"></i> Category ID <span class="text-danger">*</span>
                            </label>
                            <input asp-for="CategoryId" type="number" class="form-control" placeholder="e.g. 1" />
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Image URL -->
                        <div class="col-md-12">
                            <label asp-for="Img" class="form-label">
                                <i class="fa-solid fa-image text-warning me-1"></i> Product Image URL <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Img" class="form-control" id="productImgInput" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="Img" class="text-danger small"></span>
                        </div>

                        <!-- Live Image Preview -->
                        <div class="col-md-12">
                            <label class="form-label text-muted small">Current / Updated Image Preview</label>
                            <div class="preview-container" id="previewContainer">
                                <i class="fa-regular fa-image text-muted fs-1 mb-2 @(!string.IsNullOrEmpty(Model.Img) ? "d-none" : "")" id="placeholderIcon"></i>
                                <span class="text-muted small @(!string.IsNullOrEmpty(Model.Img) ? "d-none" : "")" id="placeholderText">Image preview will appear here</span>
                                <img id="livePreviewImg" src="@Model.Img" class="preview-img shadow-sm @(string.IsNullOrEmpty(Model.Img) ? "d-none" : "")" alt="Preview" />
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-12 mt-4 d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 10px;">
                                <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-warning px-4 py-2 shadow-sm text-dark fw-bold" style="border-radius: 10px;">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const imgInput = document.getElementById('productImgInput');
        const previewImg = document.getElementById('livePreviewImg');
        const icon = document.getElementById('placeholderIcon');
        const text = document.getElementById('placeholderText');

        function updatePreview() {
            const url = imgInput.value.trim();
            if (url) {
                previewImg.src = url;
                previewImg.onload = function () {
                    previewImg.classList.remove('d-none');
                    icon.classList.add('d-none');
                    text.classList.add('d-none');
                };
                previewImg.onerror = function () {
                    previewImg.classList.add('d-none');
                    icon.classList.remove('d-none');
                    text.classList.remove('d-none');
                    text.textContent = 'Invalid image URL or unable to load';
                };
            } else {
                previewImg.classList.add('d-none');
                icon.classList.remove('d-none');
                text.classList.remove('d-none');
                text.textContent = 'Image preview will appear here';
            }
        }

        imgInput.addEventListener('input', updatePreview);
    </script>
}