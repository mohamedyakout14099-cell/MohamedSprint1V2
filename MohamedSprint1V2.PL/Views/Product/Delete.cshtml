@model MohamedSprint1V2.DLL.ModelVM.Product.UpdateProductVM

@{
    ViewData["Title"] = "Delete Product";
}

<h2 class="text-danger">Delete Product</h2>

<h4>Are you sure you want to delete this product?</h4>

<hr />

<div class="mb-3">
    <label>Name</label>
    <input class="form-control" value="@Model.Name" readonly />
</div>

<div class="mb-3">
    <label>Description</label>
    <input class="form-control" value="@Model.Description" readonly />
</div>

<div class="mb-3">
    <label>Price</label>
    <input class="form-control" value="@Model.Price" readonly />
</div>

<div class="mb-3">
    <label>Image</label>
    <input class="form-control" value="@Model.Img" readonly />
</div>

<div class="mb-3">
    <label>Category Id</label>
    <input class="form-control" value="@Model.CategoryId" readonly />
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>